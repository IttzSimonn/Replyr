{
  "expo": {
    "name": "Replyr",
    "slug": "replyr",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "replyr",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.replyr.app",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6C63FF"
      },
      "package": "com.replyr.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "sdkVersion": "54.0.0",
    "experiments": {
      "typedRoutes": true
    }
  }
}
